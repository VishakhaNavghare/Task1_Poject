      "source": [
        "#Check whether a number is even or odd.\n",
        "\n",
        "num=int(input(\"Enter the number: \"))\n",
        "if(num%2==0):\n",
        "  print(\"{0} is Even\".format(num))\n",
        "else:\n",
        "  print(\"{0} is Odd\".format(num))"
