      "source": [
        "#Check whether a number is positive, negative, or zero.\n",
        "\n",
        "num=int(input('Enter the number: '))\n",
        "if num>0:\n",
        "    print('The number is positive')\n",
        "elif num<0:\n",
        "    print('The number is negative')\n",
        "else:\n",
        "    print('The number is zero')"
      ]
    }
  ]
